{
  "appId": "com.bappi.sonkolpo",
  "appName": "সংকল্প OS",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#1c7a63",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#f6f7f5",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body"
    },
    "LocalNotifications": {
      "iconColor": "#1c7a63"
    }
  }
}